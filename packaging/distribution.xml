<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Butterfader @VERSION@</title>
    <organization>com.arrow</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="For Ableton Live, FL Studio, Bitwig, Reaper, Studio One, Cubase and friends.">
        <pkg-ref id="com.arrow.butterfader.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU) plug-in" description="For Logic Pro, GarageBand and MainStage.">
        <pkg-ref id="com.arrow.butterfader.au"/>
    </choice>
    <choice id="standalone" title="Standalone app" description="Butterfader without a DAW, in /Applications.">
        <pkg-ref id="com.arrow.butterfader.standalone"/>
    </choice>

    <pkg-ref id="com.arrow.butterfader.vst3" version="@VERSION@">Butterfader-vst3.pkg</pkg-ref>
    <pkg-ref id="com.arrow.butterfader.au" version="@VERSION@">Butterfader-au.pkg</pkg-ref>
    <pkg-ref id="com.arrow.butterfader.standalone" version="@VERSION@">Butterfader-standalone.pkg</pkg-ref>
</installer-gui-script>
