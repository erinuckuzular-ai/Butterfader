<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Butterfader @VERSION@</title>
    <organization>com.butterfader</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="For Premiere Pro, Audition, and most DAWs.">
        <pkg-ref id="com.butterfader.butterfader.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU) plug-in" description="For Premiere Pro and Audition on Mac, Logic Pro and GarageBand.">
        <pkg-ref id="com.butterfader.butterfader.au"/>
    </choice>

    <pkg-ref id="com.butterfader.butterfader.vst3" version="@VERSION@">Butterfader-vst3.pkg</pkg-ref>
    <pkg-ref id="com.butterfader.butterfader.au" version="@VERSION@">Butterfader-au.pkg</pkg-ref>
</installer-gui-script>
